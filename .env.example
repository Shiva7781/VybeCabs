# App
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vybe_cabs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Allocation engine tuning
# Comma-separated search radius (km) per retry round. Round count = number of entries here.
ALLOCATION_RADIUS_KM_ROUNDS=3,6,10
# Max drivers notified per round
ALLOCATION_CANDIDATES_PER_ROUND=5
# How long (ms) drivers have to accept before the round times out and the next round starts
ALLOCATION_TIMEOUT_MS=15000
